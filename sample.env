# Google AI Studio API Key (Required)
# Get your API key from: https://aistudio.google.com/
GOOGLE_API_KEY="your_google_api_key_here"

# Google OAuth credentials for Calendar and Tasks access
# 1. Create an OAuth client in Google Cloud.
# 2. Add the ADK Web redirect URI that matches the port you actually run.
#    Example for the README command below:
#    http://127.0.0.1:8000/dev-ui/
# 3. Copy the client ID and client secret here.
OAUTH_CLIENT_ID=""
OAUTH_CLIENT_SECRET=""

# Optional app timezone used for relative date handling and display
APP_TIMEZONE="Asia/Kolkata"
